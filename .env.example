# Public URL of the directory server. Used when generating grantee edit links.
PUBLIC_BASE_URL=http://localhost:3000

# Data mode: "supabase" or "preview". Leave it out to auto-detect — the server
# picks "supabase" when both values below are set, otherwise "preview".
# preview stores review submissions under .data/. It is for local review only.
# DB_MODE=supabase

# Supabase project settings (Settings > API). Keep the service-role key
# server-side — never expose it to the browser.
SUPABASE_URL=replace-with-your-supabase-project-url
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-supabase-service-role-key

# Public anon key (Settings > API) — baked into netlify/config.js at build
# time by `npm run build:netlify`. Safe for the browser (RLS read-only).
SUPABASE_ANON_KEY=replace-with-your-supabase-anon-key

# Generate a long random value, for example:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PROFILE_LINK_SECRET=replace-with-at-least-32-random-characters

PORT=3000
DIRECTORY_FILE=DDISA - Grantee Directory.html
