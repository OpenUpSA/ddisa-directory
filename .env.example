# Data mode: "supabase" or "preview". Leave it out to auto-detect — the server
# picks "supabase" when both values below are set, otherwise "preview".
# preview stores review submissions under .data/. It is for local review only.
# DB_MODE=supabase

# Supabase project settings (Settings > API). Keep the service-role key
# server-side — never expose it to the browser.
SUPABASE_URL=replace-with-your-supabase-project-url
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-supabase-service-role-key

# Public anon key (Settings > API) — confirms sign-in sessions server-side
# and is baked into netlify/config.js at build time by `npm run build:netlify`.
# Safe for the browser (RLS read-only).
SUPABASE_ANON_KEY=replace-with-your-supabase-anon-key

# Support Desk (/support-desk). "preview" (default) stores tickets under
# .data/. "production" requires every Trello/Resend/Slack value below and
# writes to the support_requests table + support-attachments bucket.
SUPPORT_DESK_MODE=preview
SUPABASE_SUPPORT_TABLE=support_requests
SUPABASE_SUPPORT_BUCKET=support-attachments
TRELLO_KEY=
TRELLO_TOKEN=
TRELLO_LIST_ID=
RESEND_API_KEY=
SUPPORT_EMAIL_FROM=
SUPPORT_EMAIL_REPLY_TO=
SLACK_SUPPORT_WEBHOOK_URL=

PORT=3000
DIRECTORY_FILE=DDISA - Grantee Directory.html
